{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-kickstarter/task.schema.json",
  "title": "Task frontmatter (tasks/TASK-NNN-slug.md)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status", "agent", "depends_on", "files_allowed", "validation", "acceptance", "max_retries", "attempts", "created", "updated"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 100 },
    "status": { "enum": ["draft", "ready", "in_progress", "review", "done", "blocked", "failed", "cancelled"] },
    "agent": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(:[a-z0-9-]+)*$" },
    "skills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "model_tier": { "enum": ["reasoning", "coding", "fast", "review", "security", "ui"] },
    "priority": { "enum": ["p0", "p1", "p2", "p3"] },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^TASK-[0-9]{3,}$" }, "uniqueItems": true },
    "files_allowed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "files_excluded": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "review": { "type": "array", "items": { "enum": ["code", "security", "ui", "architecture"] }, "uniqueItems": true },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cmd", "expect"],
        "properties": {
          "cmd": { "type": "string", "minLength": 1 },
          "expect": { "type": "string", "minLength": 1 }
        }
      }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "max_retries": { "type": "integer", "minimum": 0, "maximum": 5 },
    "attempts": { "type": "integer", "minimum": 0 },
    "blocked_reason": { "type": ["string", "null"] },
    "parent": { "type": ["string", "null"], "pattern": "^TASK-[0-9]{3,}$" },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" }
  }
}
